# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# Google Cloud / BigQuery
GCP_PROJECT_ID=dien-project-id-vao-day
BQ_DATASET=oulad
BQ_LOCATION=US
# Đường dẫn TRONG container tới file khóa service account (đặt file vào thư mục secrets/)
GOOGLE_APPLICATION_CREDENTIALS=/work/secrets/gcp-key.json

# PostgreSQL (container postgres)
POSTGRES_USER=oulad
POSTGRES_PASSWORD=oulad
POSTGRES_DB=oulad
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Spark
SPARK_DRIVER_MEMORY=3g
