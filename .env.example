# Copy file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# Google Cloud / BigQuery
GCP_PROJECT_ID=dien-project-id-vao-day
BQ_DATASET=oulad
BQ_LOCATION=US
# Đường dẫn TRONG container tới file khóa service account (đặt file vào thư mục secrets/)
GOOGLE_APPLICATION_CREDENTIALS=/work/secrets/gcp-key.json

# Backend mặc định cho dashboard; đặt DATA_BACKEND=duckdb để chạy cục bộ với Parquet
DATA_BACKEND=bigquery

# PostgreSQL (container postgres)
POSTGRES_USER=oulad
POSTGRES_PASSWORD=oulad
POSTGRES_DB=oulad
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Spark
SPARK_DRIVER_MEMORY=3g

# Kafka (chỉ dùng khi chạy docker compose --profile stream)
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_TOPIC=oulad.clicks

# Airflow: báo lỗi khi task của DAG lỗi hẳn. Để trống thì chỉ ghi data/airflow_alerts.jsonl.
# Điền URL webhook của Discord hoặc Slack để nhận tin nhắn. Đây là bí mật: chỉ để trong .env, không commit.
ALERT_WEBHOOK_URL=
